# flow-dictate environment template
# Copy to .env and adjust values for your machine:
#   cp .env.example .env
# flow-dictate reads .env automatically from the current working directory.
# To set hotkey interactively, run:
#   uv run flow-dictate hotkey-setup

# Required when using the `api` or `realtime` backend.
OPENAI_API_KEY=your_openai_api_key_here

# Core runtime settings.
# Supported values: stub, api, realtime
FLOW_DICTATE_BACKEND=stub
FLOW_DICTATE_OUTPUT_MODE=stdout
FLOW_DICTATE_HOTKEY=cmd+shift+space
FLOW_DICTATE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional audio tuning.
FLOW_DICTATE_SAMPLE_RATE_HZ=24000
FLOW_DICTATE_CHANNELS=1
FLOW_DICTATE_AUDIO_INPUT_DEVICE=
FLOW_DICTATE_MAX_RECORD_SECONDS=30.0

# Optional OpenAI backend settings.
FLOW_DICTATE_OPENAI_API_KEY_ENV=OPENAI_API_KEY
FLOW_DICTATE_REALTIME_WEBSOCKET_URL=wss://api.openai.com/v1/realtime
FLOW_DICTATE_REALTIME_CONNECT_TIMEOUT_SECONDS=15.0
FLOW_DICTATE_REALTIME_RESPONSE_TIMEOUT_SECONDS=30.0

# Optional injector and runtime tuning.
FLOW_DICTATE_ACTIVE_APP_INSERTION_STRATEGY=clipboard-paste
FLOW_DICTATE_ACTIVE_APP_FALLBACK_TO_CLIPBOARD=true
FLOW_DICTATE_TEMP_AUDIO_DIR=/tmp/flow-dictate
FLOW_DICTATE_DAEMON_POLL_INTERVAL_SECONDS=0.10
